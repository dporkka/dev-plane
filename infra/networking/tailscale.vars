# tailscale.vars -- Tailscale overlay deployment variables for the agent mesh.
#
# Source this file before running deployment playbooks:
#   set -a; . tailscale.vars; set +a
#
# Security: this file contains NO secrets. Auth credentials are referenced as
# file paths and must be provisioned out-of-band (e.g. SOPS, 1Password CLI, or
# an orchestrator secret store).

set -a

# -----------------------------------------------------------------------------
# Auth strategy
# -----------------------------------------------------------------------------
# Supported methods:
#   - "oauth-client"  : Tailscale OAuth client secret (recommended for CI/CD)
#   - "authkey"       : Reusable pre-auth key (useful for one-shot onboarding)
#
# The actual secret is read from a file at runtime; inline values are rejected.
TAILSCALE_AUTH_METHOD="oauth-client"
TAILSCALE_OAUTH_CLIENT_ID="ts-oauth-dev-plane"
TAILSCALE_OAUTH_SECRET_FILE="/etc/tailscale/oauth-client-secret"
# TAILSCALE_AUTHKEY_FILE="/etc/tailscale/authkey"

# -----------------------------------------------------------------------------
# Tags applied to every mesh node.
# Tailnet ACLs should scope tag:agent-mesh to the 100.x.x.x overlay and the
# ports required by NATS / wasmCloud / SSH.
# -----------------------------------------------------------------------------
TAILSCALE_TAGS="tag:agent-mesh,tag:nats,tag:agent-node"

# -----------------------------------------------------------------------------
# Mesh host roles and Tailscale IPs.
# Replace the placeholder 100.64.0.x addresses with the real assignments from
# your Tailnet after the first enrollment.
# -----------------------------------------------------------------------------
TAILSCALE_IP_command_tower="100.64.0.1"   # Windows Command Tower workstation
TAILSCALE_IP_wsl2="100.64.0.2"            # Local Linux VM (WSL2)
TAILSCALE_IP_minipc="100.64.0.3"          # Physical local Ubuntu Mini-PC
TAILSCALE_IP_contabo_vps_0="100.64.0.10"  # Contabo Ubuntu VPS instance 0
TAILSCALE_IP_contabo_vps_1="100.64.0.11"  # Contabo Ubuntu VPS instance 1
TAILSCALE_IP_nats_core_0="100.64.0.20"    # NATS JetStream seed node

# -----------------------------------------------------------------------------
# Convenience list used by nats.conf.template rendering.
# Peers include the local node; routes are generated from these IPs.
# -----------------------------------------------------------------------------
NATS_PEERS=(
  "${TAILSCALE_IP_nats_core_0}"
)

# -----------------------------------------------------------------------------
# Join examples (run after installing tailscaled on each node):
# -----------------------------------------------------------------------------
#   sudo tailscale up \
#     --authkey="$(cat "${TAILSCALE_OAUTH_SECRET_FILE}")" \
#     --hostname="${HOSTNAME}" \
#     --advertise-tags="${TAILSCALE_TAGS}" \
#     --accept-routes --reset
set +a
